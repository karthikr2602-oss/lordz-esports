datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id               String     @id @default(uuid())
  username         String?    @unique
  email            String     @unique
  passwordHash     String
  role             String     @default("PLAYER") // ADMIN, PLAYER
  ign              String?
  fullName         String?
  avatarUrl        String?
  phone            String?
  discord          String?
  gamingExperience String?
  primaryGame      String?    @default("FREE FIRE MAX")
  device           String?
  bio              String?
  status           String     @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  auditLogs        AuditLog[]
}

model Tournament {
  id                String                   @id @default(uuid())
  title             String
  slug              String?                  @unique
  game              String                   @default("FREE FIRE MAX")
  gameCategory      String                   @default("FREE FIRE MAX") // FREE FIRE, FREE FIRE MAX
  status            String                   @default("UPCOMING") // DRAFT, REGISTRATION_OPEN, REGISTRATION_CLOSED, ONGOING, COMPLETED, CANCELLED, ARCHIVED, UPCOMING, LIVE
  prizePool         String                   @default("₹50,000")
  firstPrize        String?
  secondPrize       String?
  thirdPrize        String?
  entryFee          String                   @default("FREE ENTRY")
  feeAmount         Int                      @default(0)
  currency          String                   @default("INR")
  slots             String                   @default("32 TEAMS")
  totalTeams        Int                      @default(32)
  registeredTeams   Int                      @default(0)
  teamSize          Int                      @default(4)
  maxPlayersPerTeam Int                      @default(5)
  substituteCount   Int                      @default(1)
  date              String
  startDate         String?
  endDate           String?
  regStartDate      String?
  regEndDate        String?
  format            String                   @default("BATTLE ROYALE • 6 MATCHES")
  featured          Boolean                  @default(false)
  tagline           String                   @default("Official Lordz Esports Tournament")
  shortDescription  String?
  description       String?
  streamUrl         String?
  bannerImage       String?
  logoImage         String?
  rules             String?
  termsConditions   String?
  upiId             String?                  @default("lordzesports@upi")
  upiQrImage        String?
  bankDetails       String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  registrations     TournamentRegistration[]
  stages            TournamentStage[]
  leaderboard       TournamentLeaderboard[]
  matches           Match[]
  standings         Standing[]
}

model TournamentStage {
  id                    String                   @id @default(uuid())
  tournamentId          String
  tournament            Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                  String                   // e.g. "ROUND 1", "ROUND 2", "QUARTER FINALS", "SEMI FINALS", "GRAND FINALS"
  order                 Int                      @default(1)
  status                String                   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  startDate             String?
  endDate               String?
  teamsCount            Int?
  qualificationCriteria String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  registrations         TournamentRegistration[]
  stageProgressions     StageProgression[]
}

model TournamentRegistration {
  id                 String                    @id @default(uuid())
  registrationNumber String?                   @unique // e.g. "LZ-FGF-00127"
  tournamentId       String
  tournament         Tournament                @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamName           String
  teamLogo           String?
  captainIgn         String
  captainName        String?
  captainPhone       String?
  captainEmail       String?
  whatsapp           String
  discordTag         String?
  playerNames        String?                   // Comma separated or JSON string
  status             String                    @default("PENDING") // PENDING, PAYMENT_PENDING, UNDER_REVIEW, APPROVED, REJECTED, WAITLISTED, DISQUALIFIED
  paymentStatus      String                    @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED, REFUNDED
  currentStageId     String?
  currentStage       TournamentStage?          @relation(fields: [currentStageId], references: [id], onDelete: SetNull)
  slotNumber         Int?
  adminNotes         String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  players            RegistrationPlayer[]
  payment            PaymentRecord?
  activityLogs       RegistrationActivityLog[]
  stageProgressions  StageProgression[]
}

model RegistrationPlayer {
  id             String                 @id @default(uuid())
  registrationId String
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  ign            String
  playerId       String?
  role           String                 @default("STARTER") // IGL, RUSHER, SNIPER, SUPPORT, ENTRY, FLEX
  phone          String?
  email          String?
  discordId      String?
  isCaptain      Boolean                @default(false)
  isSubstitute   Boolean                @default(false)
  createdAt      DateTime               @default(now())
}

model PaymentRecord {
  id             String                 @id @default(uuid())
  registrationId String                 @unique
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  amount         Int                    @default(0)
  method         String                 @default("UPI")
  utr            String?
  payerName      String?
  screenshot     String?
  status         String                 @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED, REFUNDED
  remarks        String?
  submittedAt    DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  adminNotes     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model TournamentLeaderboard {
  id              String     @id @default(uuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamName        String
  tag             String?
  rank            Int        @default(1)
  matchesPlayed   Int        @default(0)
  wins            Int        @default(0)
  losses          Int        @default(0)
  kills           Int        @default(0)
  placementPoints Int        @default(0)
  bonusPoints     Int        @default(0)
  totalPoints     Int        @default(0)
  status          String     @default("ACTIVE")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model StageProgression {
  id             String                 @id @default(uuid())
  tournamentId   String
  registrationId String
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStageId    String?
  toStageId      String
  stage          TournamentStage        @relation(fields: [toStageId], references: [id], onDelete: Cascade)
  movedBy        String?
  movedAt        DateTime               @default(now())
}

model RegistrationActivityLog {
  id             String                 @id @default(uuid())
  registrationId String
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  action         String
  performedBy    String?
  details        String?
  createdAt      DateTime               @default(now())
}


model Match {
  id               String      @id @default(uuid())
  tournamentId     String?
  tournament       Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  tournamentName   String?
  status           String      @default("UPCOMING") // LIVE, UPCOMING, RESULT
  stage            String      @default("GRAND FINALS")
  game             String      @default("FREE FIRE MAX")
  map              String      @default("BERMUDA")
  teamAName        String      @default("LORDZ ESPORTS")
  teamATag         String      @default("LORDZ")
  teamAScore       Int?        @default(0)
  teamAPoints      Int?        @default(0)
  teamBName        String
  teamBTag         String
  teamBScore       Int?        @default(0)
  teamBPoints      Int?        @default(0)
  winner           String?
  startTime        String?
  countdownSeconds Int?
  streamUrl        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Standing {
  id            String      @id @default(uuid())
  tournamentId  String?
  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  rank          String
  team          String
  tag           String
  chickenDinner String      @default("00")
  matches       String      @default("02")
  position      String      @default("00")
  finishes      String      @default("00")
  total         String      @default("00")
  isTopThree    Boolean     @default(false)
  sortOrder     Int         @default(0)
  updatedAt     DateTime    @updatedAt
}

model Player {
  id            String   @id @default(uuid())
  ign           String   @unique
  realName      String
  jerseyNumber  String
  role          String   @default("RUSHER") // IGL, RUSHER, SNIPER, SUPPORT, FRAGGER
  game          String   @default("FREE FIRE MAX")
  team          String   @default("LORDZ ESPORTS")
  kdRatio       String   @default("4.00")
  headshotRate  String   @default("65%")
  matchesPlayed Int      @default(100)
  featuredQuote String   @default("Built for the ones who keep pushing.")
  avatarUrl     String?
  avatarBg      String?
  isCaptain     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Legend {
  id                  String   @id @default(uuid())
  ign                 String   @unique
  realName            String
  role                String
  activeYears         String   // e.g. "2023 - 2025"
  retiredJerseyNumber String?
  achievements        String   // JSON string or bullet points
  hallOfFameBio       String
  avatarUrl           String?
  highlightVideoUrl   String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  subtitle      String?
  description   String?
  tag           String?  @default("OFFICIAL ATHLETE SPEC")
  price         Int      @default(1299)
  originalPrice Int?     @default(1999)
  stock         Int      @default(100)
  category      String   @default("JERSEY") // JERSEY, HOODIE, ACCESSORY, GEAR
  sizes         String   @default("[\"S\",\"M\",\"L\",\"XL\",\"2XL\"]")
  frontImage    String?
  backImage     String?
  upiId         String?  @default("lordzesports@upi")
  upiQrImage    String?
  hasCustomIgn  Boolean  @default(false)
  specs         String?
  isAvailable   Boolean  @default(true)
  isFeatured    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Order {
  id                   String   @id @default(uuid())
  orderNumber          String   @unique
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName          String   @default("LORDZ PRO COMBAT JERSEY 2026")
  customerName         String
  customerEmail        String
  customerPhone        String
  address              String
  city                 String
  state                String
  pincode              String
  size                 String   @default("L")
  customIgn            String?
  customNumber         String?
  totalAmount          Int      @default(1299)
  paymentMethod        String   @default("UPI") // UPI, COD, ONLINE
  paymentStatus        String   @default("PENDING") // PENDING, PAID, FAILED, VERIFIED
  utrNumber            String?
  orderStatus          String   @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  courierPartner       String?
  trackingNumber       String?
  expectedDeliveryDate String?
  adminNotes           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model NewsArticle {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  excerpt    String
  content    String?
  category   String   @default("TOURNAMENT") // TOURNAMENT, TEAM, PLAYER, COMMUNITY, ESPORTS
  date       String
  readTime   String   @default("3 MIN READ")
  author     String   @default("Lordz Editorial")
  badgeColor String?
  coverImage String?
  published  Boolean  @default(true)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Partner {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("Gaming")
  tier       String   @default("OFFICIAL PARTNER") // MAIN SPONSOR, OFFICIAL PARTNER, BROADCAST PARTNER
  logoImage  String?
  cardImage  String?
  websiteUrl String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MediaItem {
  id          String   @id @default(uuid())
  type        String   @default("VIDEOS") // VIDEOS, HIGHLIGHTS, PHOTOS, SHORTS
  title       String
  duration    String?
  views       String   @default("10K VIEWS")
  date        String
  game        String   @default("FREE FIRE MAX")
  youtubeId   String?  @default("dQw4w9WgXcQ")
  thumbnail   String?
  tag         String   @default("FEATURED")
  description String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL") // GENERAL, HERO, TICKER, STATS, SOCIAL, SEO
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  user       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String
  action     String   // e.g. "CREATE_TOURNAMENT", "APPROVE_REGISTRATION", "UPDATE_ORDER"
  resource   String   // e.g. "Tournament", "Order"
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model PartnerPlan {
  id           String   @id @default(uuid())
  slug         String   @unique // bronze, silver, gold, diamond, lifetime
  name         String   // Bronze Partner, Silver Partner, etc.
  badge        String   // BRONZE, SILVER, GOLD ★ MOST POPULAR, DIAMOND, LIFETIME
  badgeColor   String   @default("amber") // bronze, silver, gold, diamond, lifetime
  price        String   // ₹499, ₹999, ₹1,999, ₹3,999, ₹9,999
  billing      String   @default("/ Month") // / Month, One-Time
  tag          String?  // Suitable For: Growing Teams & Creators, etc.
  subheading   String?  // EVERYTHING IN BRONZE, etc.
  features     String   // JSON string array of features
  ctaText      String   // SUBSCRIBE BRONZE, GET LIFETIME ACCESS
  isPopular    Boolean  @default(false)
  isLifetime   Boolean  @default(false)
  limitedSlots Boolean  @default(false)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PartnerInquiry {
  id            String   @id @default(uuid())
  planId        String?
  planName      String   // Gold Partner
  planPrice     String   // ₹1,999 / Month
  orgName       String   // Brand or Guild Name
  contactName   String
  email         String
  phone         String
  discordTag    String?
  websiteUrl    String?
  message       String?
  status        String   @default("PENDING") // PENDING, CONTACTED, APPROVED, REJECTED
  paymentStatus String   @default("PENDING") // PENDING, PAID
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

